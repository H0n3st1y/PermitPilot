# Set public values before building; Next embeds them in browser bundles.
# Actual public HTTPS site origin, e.g. your deployment domain. Leave blank for
# local previews; social images are advertised only for a valid public origin.
NEXT_PUBLIC_SITE_URL=

# Use the project's HTTPS base URL, without /rest/v1.
NEXT_PUBLIC_SUPABASE_URL=
# Public anon key only. Never use a service-role key here.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, server-only citation explanations. Leave blank until the production
# access controls and rate-limit checklist in docs/PRODUCTION.md is satisfied.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
